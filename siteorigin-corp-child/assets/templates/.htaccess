# Privu template downloads – keep the raw files out of direct browsing.
Options -Indexes

# No PHP execution inside the assets folder.
<FilesMatch "\.(php|php[0-9]|phtml|phar)$">
    Require all denied
</FilesMatch>

# Files are served by the signed download handler only.
<FilesMatch "\.(xlsx|xls|csv)$">
    Require all denied
</FilesMatch>
